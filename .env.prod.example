# Production settings for docker-compose.prod.yml. Placeholders only.
#
# 1. Copy this file to .env.prod (it is git-ignored) and replace every value.
# 2. Use URL-safe secrets only (letters and digits). Make each one with: openssl rand -hex 24
#    Passwords are placed inside connection URLs without escaping, so characters such as @ : / ? break them.
# 3. Start with: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# The app refuses to start in production while a secret is empty, a change-me placeholder,
# or a stock default (postgres, guest). The RabbitMQ user must not be guest.
#
# The Postgres and RabbitMQ volumes keep the credentials they were first started with.
# Changing POSTGRES_PASSWORD, RABBITMQ_USER or RABBITMQ_PASSWORD later does not change them inside the volumes.

POSTGRES_USER=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=change-me
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me-too

# Payments (optional until you take payments; an empty webhook secret makes the webhook answer 503)
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
